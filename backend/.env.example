FLOWPILOT_ENV=development
# fake: testler ve CI (ADR-008). gemini: gerçek model (ör. FLOWPILOT_LLM_MODEL=gemini-3.5-flash-lite).
FLOWPILOT_LLM_PROVIDER=fake
FLOWPILOT_LLM_MODEL=
GEMINI_API_KEY=
FLOWPILOT_DATABASE_URL=postgresql+psycopg://flowpilot:flowpilot@localhost:5433/flowpilot
FLOWPILOT_STORAGE_DIR=var/attachments
# IMAP adaptörü (isteğe bağlı)
FLOWPILOT_IMAP_HOST=
FLOWPILOT_IMAP_USER=
FLOWPILOT_IMAP_PASSWORD=
# Panel oturum çerezini imzalar; canlıda uzun rastgele bir değer olmalı.
FLOWPILOT_SECRET_KEY=dev-secret-change-me
# Demo kullanıcılarının şifresi (uv run flowpilot users demo)
FLOWPILOT_DEMO_PASSWORD=flowpilot-demo
# Sınıflandırma motoru: llm (Gemini vb.) ya da clef (Cloudflare karar modeli)
FLOWPILOT_DECISION_ENGINE=llm
FLOWPILOT_CLEF_MODEL=clef-flash
# Cloudflare Workers AI (yalnızca clef için): hesap kimliği + "Workers AI" izinli API anahtarı
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
