FLOWPILOT_ENV=development
# fake: testler ve CI (ADR-008). gemini: gerçek model (ör. FLOWPILOT_LLM_MODEL=gemini-3.5-flash-lite).
FLOWPILOT_LLM_PROVIDER=fake
FLOWPILOT_LLM_MODEL=
GEMINI_API_KEY=
FLOWPILOT_DATABASE_URL=postgresql+psycopg://flowpilot:flowpilot@localhost:5433/flowpilot
FLOWPILOT_STORAGE_DIR=var/attachments
# IMAP adaptörü ve işleyici (`flowpilot worker`). Gmail: imap.gmail.com, kullanıcı = adres,
# şifre = Google hesabındaki 16 haneli "uygulama şifresi" (hesap şifresi değil).
FLOWPILOT_IMAP_HOST=
FLOWPILOT_IMAP_PORT=993
FLOWPILOT_IMAP_USER=
FLOWPILOT_IMAP_PASSWORD=
FLOWPILOT_IMAP_FOLDER=INBOX
# Panel oturum çerezini imzalar; canlıda uzun rastgele bir değer olmalı.
FLOWPILOT_SECRET_KEY=dev-secret-change-me
# Demo kullanıcılarının şifresi (uv run flowpilot users demo)
FLOWPILOT_DEMO_PASSWORD=flowpilot-demo
# Sınıflandırma motoru: llm (Gemini vb.), clef (Cloudflare), subq (SubQ Snap) ya da cascade
# (ADR-013: önce subq, emin değilse llm, sonra insan; SUBQ_API_KEY + FLOWPILOT_LLM_PROVIDER=gemini gerekir)
FLOWPILOT_DECISION_ENGINE=llm
FLOWPILOT_CLEF_MODEL=clef-flash
# Cloudflare Workers AI (yalnızca clef için): hesap kimliği + "Workers AI" izinli API anahtarı
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# SubQ (yalnızca subq için): console.subq.ai anahtarı
FLOWPILOT_SUBQ_MODEL=subq-snap-1.2
SUBQ_API_KEY=
# Karar modeli soru sürümü: typed-v2 (varsayılan) ya da typed-v3 (asıl + ek departman)
FLOWPILOT_TYPED_PROMPT=typed-v2
